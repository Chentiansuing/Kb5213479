/* Windows 11 Setup Simulator 2.1.0 — 基础样式（外部依赖） */

:root{
  --accent:#0067c0;
  --accent-hover:#1976c9;
  --accent-press:#005a9e;
  --ink:#1b1b1b;
  --ink-2:#575757;
  --ink-3:#8b8b8b;
  --line:rgba(22,42,74,.13);
  --radius:6px;
  --card:rgba(251,252,254,.80);
  --font:"Segoe UI Variable Text","Segoe UI","Microsoft YaHei UI","Microsoft YaHei",system-ui,-apple-system,sans-serif;
}
*{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0; font-family:var(--font); color:var(--ink); background:#edf2fb;
  overflow:hidden; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  user-select:none; cursor:default;
}
button{font-family:inherit;}
input,select{font-family:inherit;}
::selection{background:rgba(0,103,192,.25);}

/* ============ 背景：Win11 Bloom 风格光影 ============ */
.bg{
  position:fixed; inset:0; z-index:0; overflow:hidden;
  background:
    radial-gradient(120% 90% at 12% 8%, #e9f2ff 0%, rgba(233,242,255,0) 58%),
    radial-gradient(95% 80% at 88% 12%, #fdeaf4 0%, rgba(253,234,244,0) 62%),
    radial-gradient(120% 100% at 48% 112%, #dbe7fa 0%, rgba(219,231,250,0) 66%),
    linear-gradient(142deg,#f7fafe 0%,#edf3fc 46%,#faf1f7 100%);
}
.bg__ribbon{
  position:absolute; left:-18vmax; top:-46vmax; width:150vmax; height:150vmax;
  background:conic-gradient(from 198deg at 50% 50%,
    rgba(255,255,255,0) 0deg, rgba(158,193,255,.42) 52deg,
    rgba(255,186,218,.34) 118deg, rgba(255,255,255,0) 196deg);
  filter:blur(72px); transform:rotate(-12deg); opacity:.9;
  animation:drift 46s ease-in-out infinite alternate;
}
.bg__ribbon--2{
  left:auto; right:-40vmax; top:auto; bottom:-55vmax; width:130vmax; height:130vmax;
  background:conic-gradient(from 20deg at 50% 50%,
    rgba(255,255,255,0) 0deg, rgba(186,206,255,.40) 60deg,
    rgba(255,205,228,.32) 130deg, rgba(255,255,255,0) 210deg);
  filter:blur(80px); animation-duration:58s; animation-direction:alternate-reverse;
}
@keyframes drift{
  0%{transform:rotate(-14deg) translate3d(-1%,0,0) scale(1);}
  100%{transform:rotate(-4deg) translate3d(2%,1%,0) scale(1.06);}
}

/* ============ 屏幕切换 ============ */
.screen{
  position:fixed; inset:0; z-index:2;
  display:flex; align-items:center; justify-content:center;
  opacity:0; visibility:hidden; transform:scale(1.004);
  transition:opacity .42s ease, transform .42s ease, visibility .42s;
}
.screen.active{opacity:1; visibility:visible; transform:none;}
.screen.dark{background:#000; z-index:8;}
.screen.oobe{z-index:5;}

/* ============ 安装程序对话框 ============ */
.dialog{
  position:relative; width:560px; max-width:calc(100vw - 56px);
  max-height:calc(100vh - 64px); display:flex; flex-direction:column;
  background:var(--card);
  -webkit-backdrop-filter:blur(46px) saturate(170%);
  backdrop-filter:blur(46px) saturate(170%);
  border-radius:10px;
  box-shadow:0 28px 80px rgba(24,45,86,.20), 0 3px 10px rgba(24,45,86,.10),
             inset 0 0 0 1px rgba(255,255,255,.70);
  overflow:hidden;
}
.dialog--wide{width:880px;}
.dialog__bar{
  height:42px; flex:none; display:flex; align-items:center; justify-content:space-between;
  padding:0 6px 0 18px; font-size:12px; color:#3b3b3b;
  border-bottom:1px solid rgba(255,255,255,.45);
}
.dialog__title{display:flex; align-items:center; gap:8px; letter-spacing:.2px;}
.dialog__title svg{opacity:.95;}
.winctl{display:flex; align-items:center;}
.winctl button{
  width:40px; height:30px; border:0; background:transparent; border-radius:4px;
  color:#4a4a4a; display:grid; place-items:center; cursor:pointer;
}
.winctl button:hover{background:rgba(0,0,0,.07);}
.winctl button.close:hover{background:#c42b1c; color:#fff;}
.dialog__body{
  padding:26px 34px 8px; overflow:auto; flex:1 1 auto;
}
.dialog__body::-webkit-scrollbar{width:10px;}
.dialog__body::-webkit-scrollbar-thumb{background:rgba(70,90,120,.28);border-radius:6px;border:3px solid transparent;background-clip:content-box;}
.dialog__foot{
  flex:none; display:flex; align-items:center; justify-content:space-between; gap:12px;
  padding:18px 26px 22px;
}
.dialog__foot .spacer{flex:1;}
h1.dlg-h{
  font-family:"Segoe UI Variable Display","Segoe UI","Microsoft YaHei UI",sans-serif;
  font-size:24px; font-weight:600; letter-spacing:.1px; margin:2px 0 6px;
}
p.dlg-sub{font-size:13px; color:var(--ink-2); margin:0 0 22px; line-height:1.65;}
p.dlg-note{font-size:12px; color:var(--ink-3); margin:10px 0 0; line-height:1.6;}

/* 表单 */
.fld{margin-bottom:16px;}
.fld__label{display:block; font-size:12.5px; color:#3f3f3f; margin-bottom:7px;}
.inp,select.inp{
  width:100%; height:34px; padding:0 12px; font-size:13px; color:var(--ink);
  background:rgba(255,255,255,.92); border:1px solid #b9b9b9; border-radius:4px;
  outline:none; transition:border-color .15s, box-shadow .15s;
}
.inp:hover{border-color:#8d8d8d;}
.inp:focus{border-color:var(--accent); box-shadow:0 0 0 1px var(--accent) inset, 0 1px 0 var(--accent);}
select.inp{
  appearance:none; -webkit-appearance:none; padding-right:30px; cursor:pointer;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6'><path d='M1 1l4 4 4-4' fill='none' stroke='%23555' stroke-width='1.4'/></svg>");
  background-repeat:no-repeat; background-position:right 12px center;
}
.inp.mono{letter-spacing:2px; font-variant-numeric:tabular-nums;}

/* 按钮 */
.btn{
  height:34px; padding:0 23px; font-size:14px; color:var(--ink);
  background:#fdfdfd; border:1px solid #cfcfcf; border-radius:4px; cursor:pointer;
  transition:background .12s, border-color .12s, color .12s;
  white-space:nowrap;
}
.btn:hover{background:#f3f6fa; border-color:#b7c3d1;}
.btn:active{background:#e9eef5;}
.btn.primary{background:var(--accent); border-color:var(--accent); color:#fff;}
.btn.primary:hover{background:var(--accent-hover); border-color:var(--accent-hover);}
.btn.primary:active{background:var(--accent-press);}
.btn.primary:disabled{background:#c8d7e7; border-color:#c8d7e7; color:#fff; cursor:default;}
.btn:disabled{color:#9b9b9b; background:#f3f3f3; border-color:#dedede; cursor:default;}
.link{
  display:inline-flex; align-items:center; gap:6px; padding:4px 2px;
  font-size:13px; color:var(--accent); background:none; border:0; cursor:pointer;
}
.link:hover{text-decoration:underline; color:var(--accent-hover);}
.link:disabled{color:#a0a0a0; cursor:default; text-decoration:none;}

/* 选项列表 */
.opt{
  display:flex; gap:13px; align-items:flex-start; padding:12px 13px;
  border:1px solid transparent; border-radius:6px; cursor:pointer; margin-bottom:2px;
  transition:background .12s, border-color .12s;
}
.opt:hover{background:rgba(0,103,192,.055);}
.opt.sel{background:rgba(0,103,192,.10); border-color:rgba(0,103,192,.30);}
.radio{
  flex:none; width:17px; height:17px; margin-top:2px; border-radius:50%;
  border:1px solid #868686; position:relative; background:#fff;
}
.opt.sel .radio{border-color:var(--accent);}
.opt.sel .radio::after{
  content:""; position:absolute; inset:3px; border-radius:50%; background:var(--accent);
}
.opt__t{font-size:13.5px; line-height:1.35;}
.opt__d{font-size:12px; color:var(--ink-2); margin-top:3px; line-height:1.55;}
.opt.dim{opacity:.62;}

/* 勾选 */
.check{display:flex; gap:10px; align-items:flex-start; font-size:13px; line-height:1.5; cursor:pointer;}
.check input{
  appearance:none; -webkit-appearance:none; flex:none; width:16px; height:16px; margin:1px 0 0;
  border:1px solid #8a8a8a; border-radius:3px; background:#fff; cursor:pointer; position:relative;
}
.check input:checked{background:var(--accent); border-color:var(--accent);}
.check input:checked::after{
  content:""; position:absolute; left:4.5px; top:1px; width:4px; height:8px;
  border:solid #fff; border-width:0 1.6px 1.6px 0; transform:rotate(42deg);
}
.check:hover input{border-color:#666;}

/* 开关 */
.switch{
  flex:none; width:42px; height:21px; border-radius:11px; background:#e4e4e4;
  border:1px solid #bcbcbc; position:relative; cursor:pointer; transition:background .18s, border-color .18s;
}
.switch::after{
  content:""; position:absolute; width:11px; height:11px; border-radius:50%;
  background:#5f5f5f; top:4px; left:5px; transition:left .18s, background .18s;
}
.switch.on{background:var(--accent); border-color:var(--accent);}
.switch.on::after{left:24px; background:#fff;}
.switch-row{
  display:flex; gap:14px; align-items:flex-start; padding:11px 12px; border-radius:6px;
}
.switch-row:hover{background:rgba(0,0,0,.03);}
.switch-row .txt{flex:1;}
.switch-row .txt b{display:block; font-size:13px; font-weight:400; margin-bottom:2px;}
.switch-row .txt span{font-size:11.5px; color:var(--ink-2); line-height:1.5;}

/* 许可条款 */
.terms{
  height:268px; overflow:auto; padding:16px 18px; font-size:12px; line-height:1.85;
  color:#3d3d3d; background:rgba(255,255,255,.72);
  border:1px solid var(--line); border-radius:4px; user-select:text; cursor:text;
}
.terms h4{font-size:12.5px; margin:14px 0 6px; color:#222;}
.terms h4:first-child{margin-top:0;}
.terms p{margin:0 0 8px;}
.terms::-webkit-scrollbar{width:10px;}
.terms::-webkit-scrollbar-thumb{background:rgba(70,90,120,.3);border-radius:6px;border:3px solid transparent;background-clip:content-box;}

/* ============ 磁盘分区 ============ */
.disk-table{
  border:1px solid #d5dbe4; border-radius:6px; overflow:hidden;
  background:rgba(255,255,255,.55); margin-top:4px;
}
.disk-row{
  display:grid; grid-template-columns:1.75fr .75fr .8fr .85fr;
  align-items:center; min-height:44px; padding:5px 14px; font-size:12.5px;
  border-bottom:1px solid rgba(22,42,74,.075); position:relative; cursor:pointer;
}
.disk-row:last-child{border-bottom:0;}
.disk-row.head{
  min-height:34px; background:rgba(240,244,250,.85); color:var(--ink-2);
  font-size:11.5px; cursor:default;
}
.disk-row:not(.head):hover{background:rgba(0,103,192,.06);}
.disk-row.sel{background:#cfe3f7; box-shadow:inset 0 0 0 1px #7fb0dd;}
.disk-row.sel::after{
  content:""; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--accent);
}
.disk-name{display:flex; flex-direction:column; gap:1px; line-height:1.35;}
.disk-name em{font-style:normal; font-size:11px; color:var(--ink-2);}
.disk-row.head > div{padding-left:0;}
.disk-tools{
  display:flex; align-items:center; gap:18px; margin-top:14px; flex-wrap:wrap;
}
.disk-tools .link{padding:2px 0;}
.disk-tools .sep{flex:1;}
.disk-info{font-size:12px; color:var(--ink-2); margin-top:14px; min-height:18px;}
.disk-tip{font-size:11.5px; color:var(--ink-3); margin-top:6px; line-height:1.6;}

/* ============ 安装进度 ============ */
.install{
  position:relative; width:min(760px,88vw); color:#1c2530;
}
.install__brand{
  display:flex; align-items:center; gap:10px; font-size:13px; color:#3d4a58;
  margin-bottom:52px; letter-spacing:.3px;
}
.install__brand .logo{display:grid; grid-template-columns:9px 9px; gap:2px;}
.install__brand .logo i{width:9px; height:9px; background:var(--accent); border-radius:1px;}
.install__brand .logo i:nth-child(2){background:#4f9bd9;}
.install__brand .logo i:nth-child(3){background:#2b7fc4;}
.install__brand .logo i:nth-child(4){background:#7fb6e3;}
.pct{
  font-family:"Segoe UI Variable Display","Segoe UI Light","Segoe UI",sans-serif;
  font-size:86px; font-weight:300; line-height:1; letter-spacing:-2px; color:#16202b;
  display:flex; align-items:baseline;
}
.pct em{font-style:normal; font-size:34px; font-weight:300; margin-left:6px; color:#39485a;}
.bar{
  width:100%; max-width:520px; height:5px; border-radius:3px; margin:30px 0 18px;
  background:rgba(24,50,86,.13); overflow:hidden;
}
.bar i{
  display:block; height:100%; width:0%; border-radius:3px;
  background:linear-gradient(90deg,#0a68c4,#3b93e0);
  box-shadow:0 0 12px rgba(59,147,224,.6);
  transition:width .25s linear;
}
.install__stage{font-size:14px; color:#2c3a49; letter-spacing:.2px;}
.install__hint{font-size:12px; color:#6c7b8c; margin-top:12px; letter-spacing:.2px;}
@keyframes spin{to{transform:rotate(360deg);}}

/* ============ 重启 / 启动 ============ */
.boot{
  display:flex; flex-direction:column; align-items:center; gap:0; color:#fff;
}
.boot__logo{width:62px; height:62px; margin-bottom:40px; opacity:.96;}
.boot__spin{
  width:32px; height:32px; border-radius:50%;
  border:2px dotted rgba(255,255,255,.85);
  animation:spin 2.6s linear infinite;
}
.boot__msg{font-size:15px; margin-top:34px; letter-spacing:.4px; color:#fff; font-weight:400;}
.boot__hint{font-size:12px; margin-top:10px; color:rgba(255,255,255,.55); letter-spacing:.3px;}
.boot--light .boot__msg{color:#1b1b1b;}
.boot--light .boot__hint{color:#7a7a7a;}
.boot--light .boot__spin{border-color:rgba(0,90,170,.28);border-top-color:var(--accent);border-style:solid;}

.restart-card{
  width:460px; padding:38px 42px 32px; text-align:center;
  background:var(--card); -webkit-backdrop-filter:blur(46px) saturate(170%);
  backdrop-filter:blur(46px) saturate(170%); border-radius:10px;
  box-shadow:0 28px 80px rgba(24,45,86,.20), inset 0 0 0 1px rgba(255,255,255,.7);
}
.restart-num{
  font-size:64px; font-weight:300; line-height:1; margin:18px 0 4px; color:var(--accent);
  font-family:"Segoe UI Variable Display","Segoe UI",sans-serif;
}
.restart-card h2{font-size:21px; font-weight:600; margin:0 0 8px;}
.restart-card p{font-size:12.5px; color:var(--ink-2); margin:0 0 4px; line-height:1.7;}

/* ============ OOBE ============ */
.screen.oobe{
  background:
    radial-gradient(52% 48% at 16% 18%, rgba(140,184,255,.52), rgba(140,184,255,0) 62%),
    radial-gradient(48% 44% at 86% 22%, rgba(255,176,212,.48), rgba(255,176,212,0) 64%),
    radial-gradient(58% 52% at 50% 104%, rgba(158,198,248,.55), rgba(158,198,248,0) 66%),
    radial-gradient(34% 30% at 72% 82%, rgba(226,196,255,.36), rgba(226,196,255,0) 68%);
}
.oobe-card{
  width:500px; max-width:calc(100vw - 56px); max-height:calc(100vh - 70px);
  padding:42px 46px 34px; border-radius:8px; position:relative;
  background:rgba(252,253,255,.90);
  -webkit-backdrop-filter:blur(50px) saturate(160%);
  backdrop-filter:blur(50px) saturate(160%);
  box-shadow:0 26px 70px rgba(20,40,78,.20), inset 0 0 0 1px rgba(255,255,255,.85);
  overflow:auto;
}
.oobe-card::-webkit-scrollbar{width:9px;}
.oobe-card::-webkit-scrollbar-thumb{background:rgba(70,90,120,.25);border-radius:6px;border:2px solid transparent;background-clip:content-box;}
.oobe-card h1{font-size:26px; font-weight:600; margin:0 0 10px; letter-spacing:.1px;}
.oobe-card .sub{font-size:12.5px; color:var(--ink-2); line-height:1.7; margin:0 0 26px;}
.oobe-foot{display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:30px;}
.oobe-foot .right{display:flex; align-items:center; gap:10px; margin-left:auto;}
.oobe-warn{
  font-size:11.5px; color:#8a5a12; background:rgba(255,244,222,.9);
  border:1px solid rgba(214,170,80,.45); border-radius:4px; padding:9px 12px; margin-top:14px;
}
.wifi{
  display:flex; align-items:center; justify-content:space-between; gap:12px;
  padding:13px 14px; border:1px solid var(--line); border-radius:6px; margin-bottom:8px;
  background:rgba(255,255,255,.6); cursor:pointer; transition:background .12s, border-color .12s;
}
.wifi:hover{background:rgba(0,103,192,.07); border-color:rgba(0,103,192,.3);}
.wifi.on{background:rgba(0,103,192,.10); border-color:rgba(0,103,192,.45);}
.wifi__l{display:flex; align-items:center; gap:11px; font-size:13px;}
.wifi__meta{font-size:11px; color:var(--ink-3);}
.wifi__bars{display:flex; align-items:flex-end; gap:2px; height:12px;}
.wifi__bars i{width:3px; background:#6b7c8f; border-radius:1px;}
.wifi__bars i:nth-child(1){height:4px;}
.wifi__bars i:nth-child(2){height:7px;}
.wifi__bars i:nth-child(3){height:10px;}
.wifi__bars i:nth-child(4){height:12px; opacity:.35;}
.wifi-status{font-size:12px; color:var(--accent); min-height:18px; margin:6px 0 2px;}
.progress-dots{display:flex; gap:5px; align-items:center;}
.progress-dots i{width:5px;height:5px;border-radius:50%;background:#9fb4c9;animation:blink 1.2s infinite;}
.progress-dots i:nth-child(2){animation-delay:.18s;}
.progress-dots i:nth-child(3){animation-delay:.36s;}
@keyframes blink{0%,100%{opacity:.25;}50%{opacity:1;}}
.oobe-loading{display:flex; flex-direction:column; align-items:center; padding:26px 0 10px;}
.oobe-loading .ring{
  width:38px;height:38px;border-radius:50%;border:2px solid rgba(0,90,170,.2);
  border-top-color:var(--accent);animation:spin 1s linear infinite;margin-bottom:26px;
}

/* ============ 桌面 ============ */
.screen.desktop{z-index:4; display:block; overflow:hidden;}
.wall{position:absolute; inset:0; background:#05101f; overflow:hidden;}
.wall::before{
  content:""; position:absolute; inset:-14%;
  background:
    radial-gradient(30% 26% at 50% 50%, rgba(214,240,255,.95), rgba(214,240,255,0) 60%),
    radial-gradient(44% 40% at 46% 52%, rgba(84,168,255,.90), rgba(84,168,255,0) 64%),
    radial-gradient(34% 30% at 62% 66%, rgba(255,120,178,.60), rgba(255,120,178,0) 68%),
    radial-gradient(38% 44% at 34% 70%, rgba(124,96,255,.60), rgba(124,96,255,0) 66%),
    radial-gradient(28% 24% at 60% 38%, rgba(110,220,255,.45), rgba(110,220,255,0) 66%),
    radial-gradient(55% 48% at 52% 45%, rgba(16,74,170,.65), rgba(16,74,170,0) 72%);
  filter:blur(40px); transform:rotate(-16deg) scale(1.18);
}
.wall .petal{
  position:absolute; left:50%; top:52%; width:78vmin; height:78vmin;
  transform:translate(-50%,-50%) rotate(-8deg);
  background:conic-gradient(from 0deg,
    rgba(255,255,255,.10), rgba(120,190,255,.30) 14%, rgba(255,255,255,.05) 30%,
    rgba(255,150,200,.22) 44%, rgba(255,255,255,.08) 58%, rgba(110,200,255,.26) 74%,
    rgba(255,255,255,.06) 88%, rgba(255,255,255,.10));
  border-radius:46% 54% 52% 48% / 50% 46% 54% 50%;
  filter:blur(28px); opacity:.55;
  animation:petal 36s ease-in-out infinite alternate;
}
@keyframes petal{
  0%{transform:translate(-50%,-50%) rotate(-8deg) scale(1);}
  100%{transform:translate(-50%,-50%) rotate(18deg) scale(1.07);}
}
.wall::after{
  content:""; position:absolute; inset:0;
  background:
    radial-gradient(70% 60% at 50% 50%, rgba(10,30,70,0) 30%, rgba(3,9,22,.55) 85%),
    linear-gradient(180deg, rgba(3,8,20,.25), rgba(3,8,20,.10) 40%, rgba(2,6,16,.55));
}
.desk-icons{position:absolute; top:18px; left:18px; display:flex; flex-direction:column; gap:6px; z-index:3;}
.dicon{
  width:88px; padding:10px 6px 8px; border-radius:4px; text-align:center;
  display:flex; flex-direction:column; align-items:center; gap:7px; cursor:pointer;
  border:1px solid transparent; color:#fff; font-size:11.5px; line-height:1.3;
  text-shadow:0 1px 3px rgba(0,0,0,.6);
}
.dicon:hover{background:rgba(255,255,255,.14); border-color:rgba(255,255,255,.18);}
.dicon.sel{background:rgba(0,120,215,.32); border-color:rgba(140,200,255,.5);}
.dicon svg{filter:drop-shadow(0 2px 4px rgba(0,0,0,.4));}
.taskbar{
  position:absolute; left:0; right:0; bottom:0; height:48px; z-index:5;
  display:grid; grid-template-columns:1fr auto 1fr; align-items:center; padding:0 10px;
  background:rgba(243,246,251,.78);
  -webkit-backdrop-filter:blur(40px) saturate(180%);
  backdrop-filter:blur(40px) saturate(180%);
  border-top:1px solid rgba(255,255,255,.55);
  box-shadow:0 -1px 12px rgba(0,0,0,.12);
}
.tb-center{display:flex; align-items:center; gap:4px;}
.tb-btn{
  width:40px; height:40px; border:0; background:transparent; border-radius:5px; cursor:pointer;
  display:grid; place-items:center; position:relative; transition:background .12s;
}
.tb-btn:hover{background:rgba(255,255,255,.55);}
.tb-btn:active{transform:scale(.94);}
.tb-btn.running::after{
  content:""; position:absolute; bottom:2px; left:50%; transform:translateX(-50%);
  width:5px; height:2.5px; border-radius:2px; background:#4a5a6b;
}
.tb-right{display:flex; align-items:center; justify-content:flex-end; gap:4px; color:#20262d; font-size:11.5px;}
.tray{padding:0 8px; height:34px; border-radius:4px; display:flex; align-items:center; gap:10px; cursor:pointer;}
.tray:hover{background:rgba(255,255,255,.55);}
.tray .clock{text-align:right; line-height:1.25; font-size:11px;}
.tray .clock b{display:block; font-weight:400;}
.start-menu{
  position:absolute; left:50%; bottom:56px; transform:translate(-50%,14px) scale(.985);
  width:640px; height:600px; max-height:calc(100vh - 80px); z-index:6;
  background:rgba(248,250,253,.86);
  -webkit-backdrop-filter:blur(52px) saturate(180%);
  backdrop-filter:blur(52px) saturate(180%);
  border-radius:10px; box-shadow:0 24px 70px rgba(0,0,0,.35), inset 0 0 0 1px rgba(255,255,255,.7);
  padding:26px 34px 0; display:flex; flex-direction:column;
  opacity:0; visibility:hidden; pointer-events:none;
  transition:opacity .22s ease, transform .22s ease, visibility .22s;
  color:#1b1b1b;
}
.start-menu.open{opacity:1; visibility:visible; pointer-events:auto; transform:translate(-50%,0) scale(1);}
.sm-search{
  height:34px; border-radius:17px; background:rgba(255,255,255,.85);
  border:1px solid rgba(0,0,0,.10); display:flex; align-items:center; gap:10px;
  padding:0 14px; font-size:12px; color:#6a6a6a; margin-bottom:22px;
}
.sm-row{display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;}
.sm-row b{font-size:13px; font-weight:600;}
.sm-row span{font-size:11px; color:#6a6a6a;}
.sm-grid{display:grid; grid-template-columns:repeat(6,1fr); gap:6px 2px; margin-bottom:22px;}
.sm-app{
  display:flex; flex-direction:column; align-items:center; gap:7px; padding:12px 4px 10px;
  border-radius:6px; cursor:pointer; font-size:11px; text-align:center; color:#2b2b2b;
}
.sm-app:hover{background:rgba(0,0,0,.055);}
.sm-app .tile{width:30px; height:30px; border-radius:7px; display:grid; place-items:center; color:#fff; font-size:13px; font-weight:600;}
.sm-foot{
  margin:auto -34px 0; height:60px; padding:0 34px; display:flex; align-items:center;
  justify-content:space-between; border-top:1px solid rgba(0,0,0,.06);
  background:rgba(255,255,255,.35);
}
.sm-user{display:flex; align-items:center; gap:10px; font-size:12px; padding:6px 10px; border-radius:5px; cursor:pointer;}
.sm-user:hover{background:rgba(0,0,0,.05);}
.sm-avatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#5aa1e8,#2b6cb0);display:grid;place-items:center;color:#fff;font-size:12px;}
.sm-power{width:34px;height:34px;border:0;background:transparent;border-radius:5px;cursor:pointer;display:grid;place-items:center;}
.sm-power:hover{background:rgba(0,0,0,.06);}
.toast-win{
  position:absolute; right:16px; bottom:60px; width:340px; z-index:7;
  background:rgba(250,251,253,.90);
  -webkit-backdrop-filter:blur(40px) saturate(170%); backdrop-filter:blur(40px) saturate(170%);
  border-radius:8px; box-shadow:0 16px 44px rgba(0,0,0,.34), inset 0 0 0 1px rgba(255,255,255,.7);
  padding:15px 17px; display:flex; gap:12px;
  transform:translateY(16px); opacity:0; visibility:hidden;
  transition:opacity .35s ease, transform .35s ease, visibility .35s;
}
.toast-win.show{opacity:1; visibility:visible; transform:none;}
.toast-win .t{font-size:12.5px; font-weight:600; margin-bottom:3px;}
.toast-win .d{font-size:11.5px; color:#4c4c4c; line-height:1.55;}

/* ============ 提示条 / 弹窗 ============ */
#toast{
  position:fixed; left:50%; bottom:44px; transform:translate(-50%,14px); z-index:80;
  background:rgba(28,32,38,.90); color:#fff; font-size:12.5px; padding:9px 18px;
  border-radius:16px; opacity:0; visibility:hidden; transition:opacity .22s, transform .22s, visibility .22s;
  pointer-events:none; box-shadow:0 10px 26px rgba(0,0,0,.25);
}
#toast.show{opacity:1; visibility:visible; transform:translate(-50%,0);}
.modal{
  position:fixed; inset:0; z-index:90; background:rgba(10,18,32,.30);
  -webkit-backdrop-filter:blur(2px); backdrop-filter:blur(2px);
  display:flex; align-items:center; justify-content:center;
  opacity:0; visibility:hidden; transition:opacity .18s, visibility .18s;
}
.modal.open{opacity:1; visibility:visible;}
.modal__card{
  width:460px; max-width:calc(100vw - 48px); background:rgba(252,253,255,.96);
  border-radius:8px; box-shadow:0 28px 80px rgba(0,0,0,.32), inset 0 0 0 1px rgba(255,255,255,.8);
  overflow:hidden; transform:scale(.97); transition:transform .18s;
}
.modal.open .modal__card{transform:none;}
.modal__title{font-size:19px; font-weight:600; padding:24px 26px 0;}
.modal__body{padding:12px 26px 6px; font-size:13px; color:var(--ink-2); line-height:1.7; user-select:text;}
.modal__body .fld{margin-top:14px;}
.modal__foot{display:flex; gap:10px; justify-content:flex-end; padding:22px 26px 24px;}

