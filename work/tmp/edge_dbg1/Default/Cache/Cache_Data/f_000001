<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Windows 11 安装程序</title>

<!-- 外部依赖：样式 -->
<link rel="stylesheet" href="styles/app.css">
<link rel="stylesheet" href="styles/windows.css">
</head>
<body>
<body>
<div class="bg"><div class="bg__ribbon"></div><div class="bg__ribbon bg__ribbon--2"></div></div>

<!-- ===== 启动 ===== -->
<section class="screen dark active" id="s-boot">
  <div class="boot">
    <svg class="boot__logo" viewBox="0 0 64 64" aria-hidden="true">
      <g fill="#ffffff"><rect x="2" y="2" width="27" height="27" rx="1.5"/><rect x="35" y="2" width="27" height="27" rx="1.5"/><rect x="2" y="35" width="27" height="27" rx="1.5"/><rect x="35" y="35" width="27" height="27" rx="1.5"/></g>
    </svg>
    <div class="boot__spin"></div>
  </div>
</section>

<!-- ===== 语言与区域 ===== -->
<section class="screen" id="s-lang">
  <div class="dialog">
    <div class="dialog__bar">
      <div class="dialog__title">
        <svg width="14" height="14" viewBox="0 0 64 64"><g fill="#0067c0"><rect x="2" y="2" width="27" height="27" rx="1.5"/><rect x="35" y="2" width="27" height="27" rx="1.5"/><rect x="2" y="35" width="27" height="27" rx="1.5"/><rect x="35" y="35" width="27" height="27" rx="1.5"/></g></svg>
        <span data-i18n="setup_title">Windows 11 安装程序</span>
      </div>
      <div class="winctl">
        <button title="最小化"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 5h8" stroke="currentColor" stroke-width="1"/></svg></button>
        <button class="close" id="btnCloseSetup" title="关闭"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1l-8 8" stroke="currentColor" stroke-width="1.2"/></svg></button>
      </div>
    </div>
    <div class="dialog__body">
      <h1 class="dlg-h" data-i18n="setup_title">Windows 11 安装程序</h1>
      <p class="dlg-sub" data-i18n="sub_lang">选择要安装的语言和其他首选项。</p>
      <div class="fld">
        <label class="fld__label" for="selLang" data-i18n="lbl_lang">要安装的语言</label>
        <select class="inp" id="selLang">
          <option>中文（简体，中国）</option>
          <option>中文（繁体，中国台湾）</option>
          <option>English (United States)</option>
          <option>日本語 (日本)</option>
        </select>
      </div>
      <div class="fld">
        <label class="fld__label" for="selTime" data-i18n="lbl_time">时间和货币格式</label>
        <select class="inp" id="selTime">
          <option>中文（简体，中国）</option>
          <option>中文（简体，新加坡）</option>
          <option>English (United States)</option>
        </select>
      </div>
      <div class="fld" style="margin-bottom:6px;">
        <label class="fld__label" for="selKb" data-i18n="lbl_kb">键盘或输入方法</label>
        <select class="inp" id="selKb">
          <option>微软拼音</option>
          <option>美式键盘</option>
          <option>微软五笔</option>
        </select>
      </div>
    </div>
    <div class="dialog__foot">
      <button class="link" id="btnRepair" data-i18n="btn_repair">修复计算机</button>
      <div class="spacer"></div>
      <button class="btn primary" data-go="key" data-enter="1" data-i18n="btn_next">下一步</button>
    </div>
  </div>
</section>

<!-- ===== 产品密钥 ===== -->
<section class="screen" id="s-key">
  <div class="dialog">
    <div class="dialog__bar">
      <div class="dialog__title" data-i18n="setup_title">Windows 11 安装程序</div>
      <div class="winctl"><button class="close" data-close-setup title="关闭"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1l-8 8" stroke="currentColor" stroke-width="1.2"/></svg></button></div>
    </div>
    <div class="dialog__body">
      <h1 class="dlg-h" data-i18n="title_key">激活 Windows</h1>
      <p class="dlg-sub">输入产品密钥可激活 Windows。如果你没有密钥，可以选择“我没有产品密钥”继续安装，稍后再激活。</p>
      <div class="fld">
        <label class="fld__label" for="keyInput" data-i18n="lbl_key">产品密钥</label>
        <input class="inp mono" id="keyInput" maxlength="29" placeholder="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" autocomplete="off" spellcheck="false">
        <p class="dlg-note" data-i18n="note_key">密钥由 25 个字符组成，输入时会自动分组。</p>
      </div>
    </div>
    <div class="dialog__foot">
      <button class="link" id="btnNoKey" data-i18n="btn_no_key">我没有产品密钥</button>
      <div class="spacer"></div>
      <button class="btn primary" id="keyNext" data-enter="1" disabled data-i18n="btn_next">下一步</button>
    </div>
  </div>
</section>

<!-- ===== 选择版本 ===== -->
<section class="screen" id="s-edition">
  <div class="dialog">
    <div class="dialog__bar">
      <div class="dialog__title" data-i18n="setup_title">Windows 11 安装程序</div>
      <div class="winctl"><button class="close" data-close-setup title="关闭"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1l-8 8" stroke="currentColor" stroke-width="1.2"/></svg></button></div>
    </div>
    <div class="dialog__body">
      <h1 class="dlg-h" data-i18n="title_edition">选择要安装的操作系统</h1>
      <p class="dlg-sub">你可以安装以下任一版本。安装完成后，可在“设置”中升级版本。</p>
      <div id="editionList">
        <div class="opt" data-edition="Windows 11 专业版">
          <span class="radio"></span>
          <div><div class="opt__t" data-i18n="ed_pro">Windows 11 专业版</div><div class="opt__d" data-i18n="ed_pro_d">面向小型企业和高级用户的完整功能，支持 BitLocker、远程桌面和 Hyper-V。</div></div>
        </div>
        <div class="opt" data-edition="Windows 11 家庭版">
          <span class="radio"></span>
          <div><div class="opt__t" data-i18n="ed_home">Windows 11 家庭版</div><div class="opt__d" data-i18n="ed_home_d">面向家庭用户的日常体验，包含全新的开始菜单、窗口布局和 Microsoft Store。</div></div>
        </div>
        <div class="opt" data-edition="Windows 11 企业版">
          <span class="radio"></span>
          <div><div class="opt__t" data-i18n="ed_ent">Windows 11 企业版</div><div class="opt__d" data-i18n="ed_ent_d">面向大型组织，提供高级安全性、设备管理和云端连接能力。</div></div>
        </div>
        <div class="opt" data-edition="Windows 11 教育版">
          <span class="radio"></span>
          <div><div class="opt__t" data-i18n="ed_edu">Windows 11 教育版</div><div class="opt__d" data-i18n="ed_edu_d">为学校、教师和学生打造，包含教育机构常用的应用与管理工具。</div></div>
        </div>
      </div>
    </div>
    <div class="dialog__foot">
      <div class="spacer"></div>
      <button class="btn primary" id="editionNext" data-enter="1" disabled data-i18n="btn_next">下一步</button>
    </div>
  </div>
</section>

<!-- ===== 许可条款 ===== -->
<section class="screen" id="s-license">
  <div class="dialog">
    <div class="dialog__bar">
      <div class="dialog__title" data-i18n="setup_title">Windows 11 安装程序</div>
      <div class="winctl"><button class="close" data-close-setup title="关闭"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1l-8 8" stroke="currentColor" stroke-width="1.2"/></svg></button></div>
    </div>
    <div class="dialog__body">
      <h1 class="dlg-h" style="font-size:21px;" data-i18n="title_license">适用的通知与许可条款</h1>
      <p class="dlg-sub" style="margin-bottom:14px;" data-i18n="sub_license">请阅读以下条款。你需要接受这些条款才能继续安装。</p>
      <div class="terms">
        <h4>MICROSOFT 软件许可条款</h4>
        <p>本许可条款是 Microsoft 公司与设备使用者之间达成的协议。本条款适用于本设备上预安装或随本设备提供的 Microsoft 软件，包括随附的媒体、印刷材料、联机或电子文档以及更新。</p>
        <h4>1. 安装和使用权利</h4>
        <p>你可以在本设备上安装和使用本软件的一个副本。设备上同时运行本软件的实例数量不得超过本许可条款允许的范围。你不得在虚拟化环境中运行本软件，除非获得 Microsoft 的另行授权。</p>
        <h4>2. 激活与验证</h4>
        <p>安装过程可能需要 Internet 连接以完成激活和验证。如果你未在许可条款允许的时间内完成激活，本软件的部分功能可能受到限制。激活信息将与设备的硬件配置关联。</p>
        <h4>3. 隐私与诊断数据</h4>
        <p>Microsoft 会收集诊断数据以帮助改进产品。你可以在首次开机设置中选择诊断数据的级别，并可随时在“设置 &gt; 隐私和安全性 &gt; 诊断和反馈”中更改该设置。</p>
        <h4>4. 更新</h4>
        <p>本软件会定期检查并安装更新。更新可能包含安全修补程序、新功能以及对已有功能的修改。安装本软件即表示你同意接收这些更新。</p>
        <h4>5. 备份与恢复</h4>
        <p>安装操作系统可能会格式化所选分区并删除其中的所有文件。在继续之前，请确认已备份重要数据。Microsoft 不对数据丢失承担责任。</p>
        <h4>6. 支持服务</h4>
        <p>本软件的支持服务受设备制造商或 Microsoft 当时提供的支持政策约束。本条款中的任何内容均不限制消费者依法享有的法定权利。</p>
        <p style="margin-top:14px;color:#888;">（以上条款为演示用途的简化文本，非 Microsoft 官方条款。）</p>
      </div>
      <label class="check" style="margin-top:16px;">
        <input type="checkbox" id="licenseCheck">
        <span data-i18n="chk_license">我接受 Microsoft 软件许可条款和适用的通知。</span>
      </label>
    </div>
    <div class="dialog__foot">
      <div class="spacer"></div>
      <button class="btn primary" id="licenseNext" data-enter="1" disabled data-i18n="btn_next">下一步</button>
    </div>
  </div>
</section>

<!-- ===== 安装类型 ===== -->
<section class="screen" id="s-type">
  <div class="dialog">
    <div class="dialog__bar">
      <div class="dialog__title" data-i18n="setup_title">Windows 11 安装程序</div>
      <div class="winctl"><button class="close" data-close-setup title="关闭"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1l-8 8" stroke="currentColor" stroke-width="1.2"/></svg></button></div>
    </div>
    <div class="dialog__body">
      <h1 class="dlg-h" data-i18n="title_type">你想执行哪种类型的安装？</h1>
      <p class="dlg-sub" data-i18n="sub_type">升级会保留文件、设置和应用；自定义安装会重新安装 Windows，你可以自行选择分区。</p>
      <div id="typeList">
        <div class="opt dim" data-type="upgrade">
          <span class="radio"></span>
          <div><div class="opt__t" data-i18n="type_upgrade">升级：安装 Windows 并保留文件、设置和应用</div><div class="opt__d" data-i18n="type_upgrade_d">当前是从安装介质启动，无法执行升级安装。请移除介质并从 Windows 中运行安装程序。</div></div>
        </div>
        <div class="opt" data-type="custom">
          <span class="radio"></span>
          <div><div class="opt__t" data-i18n="type_custom">自定义：仅安装 Windows（高级）</div><div class="opt__d" data-i18n="type_custom_d">使用此选项全新安装 Windows。你可以选择要安装到的分区，已安装的程序和文件不会保留。</div></div>
        </div>
      </div>
    </div>
    <div class="dialog__foot">
      <div class="spacer"></div>
      <button class="btn primary" id="typeNext" data-enter="1" disabled data-i18n="btn_next">下一步</button>
    </div>
  </div>
</section>

<!-- ===== 磁盘分区 ===== -->
<section class="screen" id="s-disk">
  <div class="dialog dialog--wide">
    <div class="dialog__bar">
      <div class="dialog__title" data-i18n="setup_title">Windows 11 安装程序</div>
      <div class="winctl"><button class="close" data-close-setup title="关闭"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1l-8 8" stroke="currentColor" stroke-width="1.2"/></svg></button></div>
    </div>
    <div class="dialog__body">
      <h1 class="dlg-h" style="font-size:22px;" data-i18n="title_disk">你想将 Windows 安装在哪里？</h1>
      <p class="dlg-sub" style="margin-bottom:16px;" data-i18n="sub_disk">你可以选择现有分区，或新建分区。安装前请确认重要数据已备份。</p>
      <div class="disk-table">
        <div class="disk-row head">
          <div data-i18n="disk_col1">名称</div><div data-i18n="disk_col2">总大小</div><div data-i18n="disk_col3">可用空间</div><div data-i18n="disk_col4">类型</div>
        </div>
        <div id="diskRows"></div>
      </div>
      <div class="disk-tools">
        <button class="link" id="btnRefresh" data-i18n="disk_link1">刷新</button>
        <button class="link" id="btnDelete" data-i18n="disk_link2">删除</button>
        <button class="link" id="btnFormat" data-i18n="disk_link3">格式化</button>
        <span class="sep"></span>
        <button class="link" id="btnNew" data-i18n="disk_link4">新建</button>
        <button class="link" id="btnDriver" data-i18n="disk_link5">加载驱动程序</button>
      </div>
      <div class="disk-info" id="diskInfo" data-i18n="disk_info_none">请选择一个分区。</div>
      <div class="disk-tip" data-i18n="disk_tip">提示：选择"主分区"后点击"下一步"即可开始安装；未分配的空间需要先点击"新建"。</div>
    </div>
    <div class="dialog__foot">
      <button class="link" data-go="type" data-i18n="btn_back">上一步</button>
      <div class="spacer"></div>
      <button class="btn primary" id="diskNext" data-enter="1" disabled data-i18n="btn_next">下一步</button>
    </div>
  </div>
</section>

<!-- ===== 安装进度 ===== -->
<section class="screen" id="s-install">
  <div class="install">
    <div class="install__brand">
      <span class="logo"><i></i><i></i><i></i><i></i></span>
      <span data-i18n="inst_brand">Windows 11</span>
    </div>
    <div class="pct"><span id="instPct">0</span><em>%</em></div>
    <div class="bar"><i id="instBar"></i></div>
    <div class="install__stage" id="instStage" data-i18n="inst_stage_1">正在复制 Windows 文件</div>
    <div class="install__hint" data-i18n-html="inst_hint">正在安装到 <span id="instTarget" data-i18n="disk_name_primary">主分区</span> · 请不要关闭你的计算机。</div>
  </div>
</section>

<!-- ===== 重启提示 ===== -->
<section class="screen" id="s-restart">
  <div class="restart-card">
    <h2 data-i18n="rst_title">Windows 需要重启才能继续</h2>
    <p data-i18n-html="rst_body">你的电脑将在 <span id="restartCount">10</span> 秒后自动重启。</p>
    <div class="restart-num" id="restartNum">10</div>
    <p style="color:#8b8b8b;" data-i18n="rst_sub">重启期间请不要关闭电脑或拔出电源。</p>
    <div style="margin-top:26px; display:flex; justify-content:center;">
      <button class="btn primary" id="btnRestartNow" data-i18n="rst_now">立即重启</button>
    </div>
  </div>
</section>

<!-- ===== 重启后准备 ===== -->
<section class="screen dark" id="s-prepare1">
  <div class="boot">
    <svg class="boot__logo" viewBox="0 0 64 64" aria-hidden="true">
      <g fill="#ffffff"><rect x="2" y="2" width="27" height="27" rx="1.5"/><rect x="35" y="2" width="27" height="27" rx="1.5"/><rect x="2" y="35" width="27" height="27" rx="1.5"/><rect x="35" y="35" width="27" height="27" rx="1.5"/></g>
    </svg>
    <div class="boot__spin"></div>
    <div class="boot__msg" data-i18n="boot_prepare">正在准备 Windows</div>
    <div class="boot__hint" data-i18n="boot_hint">请不要关闭你的计算机</div>
  </div>
</section>

<!-- ===== OOBE：区域 ===== -->
<section class="screen oobe" id="s-region">
  <div class="oobe-card">
    <h1 data-i18n="oobe_region_title">让我们为你设置区域</h1>
    <p class="sub" data-i18n="oobe_region_sub">选择你所在的国家或地区，以便 Windows 使用合适的日期、时间和内容设置。</p>
    <div class="fld">
      <label class="fld__label" for="regionSel" data-i18n="oobe_country">国家或地区</label>
      <select class="inp" id="regionSel">
        <option>中国</option><option>中国香港特别行政区</option><option>中国台湾</option>
        <option>新加坡</option><option>日本</option><option>美国</option><option>英国</option>
      </select>
    </div>
    <div class="oobe-foot">
      <div class="right"><button class="btn primary" data-go="keyboard" data-enter="1" data-i18n="oobe_yes">是</button></div>
    </div>
  </div>
</section>

<!-- ===== OOBE：键盘 ===== -->
<section class="screen oobe" id="s-keyboard">
  <div class="oobe-card">
    <h1 data-i18n="oobe_kb_title">你想使用哪种键盘布局？</h1>
    <p class="sub" data-i18n="oobe_kb_sub">我们会根据你的区域推荐一种布局。你也可以添加其他布局。</p>
    <div id="kbList">
      <div class="opt sel" data-kb="微软拼音"><span class="radio"></span><div><div class="opt__t" data-i18n="kb_pinyin">微软拼音</div><div class="opt__d" data-i18n="kb_pinyin_d">中文（简体）· 推荐</div></div></div>
      <div class="opt" data-kb="微软五笔"><span class="radio"></span><div><div class="opt__t" data-i18n="kb_wubi">微软五笔</div><div class="opt__d" data-i18n="kb_wubi_d">中文（简体）</div></div></div>
      <div class="opt" data-kb="美式键盘"><span class="radio"></span><div><div class="opt__t" data-i18n="kb_us">美式键盘</div><div class="opt__d" data-i18n="kb_us_d">英语（美国）</div></div></div>
    </div>
    <div class="oobe-foot">
      <button class="link" data-go="keyboard2" data-i18n="oobe_skip">跳过</button>
      <div class="right"><button class="btn primary" data-go="keyboard2" data-enter="1" data-i18n="oobe_yes">是</button></div>
    </div>
  </div>
</section>

<!-- ===== OOBE：第二键盘 ===== -->
<section class="screen oobe" id="s-keyboard2">
  <div class="oobe-card">
    <h1 data-i18n="kb2_title">是否要添加第二种键盘布局？</h1>
    <p class="sub" data-i18n="kb2_sub">如果你经常使用多种语言输入，可以再添加一种键盘布局。你可以稍后在"设置"中添加。</p>
    <div id="kb2List">
      <div class="opt sel" data-kb2="不添加"><span class="radio"></span><div><div class="opt__t" data-i18n="oobe_skip">跳过</div><div class="opt__d" data-i18n="kb2_skip_d">暂时只使用当前键盘布局</div></div></div>
      <div class="opt" data-kb2="美式键盘"><span class="radio"></span><div><div class="opt__t" data-i18n="kb_us">美式键盘</div><div class="opt__d" data-i18n="kb_us_d">英语（美国）</div></div></div>
    </div>
    <div class="oobe-foot">
      <div class="right"><button class="btn primary" data-go="network" data-enter="1" data-i18n="btn_next">下一步</button></div>
    </div>
  </div>
</section>

<!-- ===== OOBE：网络 ===== -->
<section class="screen oobe" id="s-network">
  <div class="oobe-card">
    <h1 data-i18n="oobe_net_title">让我们将你连接到网络</h1>
    <p class="sub" data-i18n="oobe_net_sub">连接后即可使用 Microsoft 账户、应用商店和云服务。选择一个可用的无线网络。</p>
    <div id="wifiList">
      <div class="wifi" data-ssid="HUAWEI-8F2C">
        <div class="wifi__l">
          <span class="wifi__bars"><i></i><i></i><i></i><i></i></span>
